// Copy this file to Config/Secrets.xcconfig (git ignores it) and fill it in.

// mars-workbench's NATIVE_API_TOKEN, as set on Vercel. Hex only: a `//` in the
// value would start a comment and cut it off.
DUMP_API_TOKEN = paste-the-token-here

// Your signing team's id (README › Set up › 5).
DEVELOPMENT_TEAM = ABCDE12345

// In the Simulator, against `npm run dev` on mars-workbench's local stack:
// DUMP_API_BASE_URL = http:/$()/localhost:3000
// DUMP_API_TOKEN = local-dev-token
